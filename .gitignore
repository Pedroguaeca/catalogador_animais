# Python / venv
__pycache__/
*.pyc
*.pyo
.venv/
.env

# Anaconda/conda
*.conda
*.ipynb_checkpoints

# Dados grandes (não versionar)
videos/
!frontend/app/videos/
frames/
dataset/images/
dataset/labels/
resultados/
*.mp4
*.AVI
*.avi
*.mov
*.mkv

# Imagens geradas (frames extraídos de vídeo)
# Não usar *.jpg / *.png globais — ignoraria assets/ e outros arquivos de UI
frames/**/*.jpg
frames/**/*.png
dataset/**/*.jpg
dataset/**/*.png

# Modelos de IA (baixar separadamente, podem ter vários GB)
*.pt
*.pth
*.pb
*.onnx
*.weights
*.h5
*.tflite

# Arquivos de trabalho temporários
lista_frames_altaconfianca.txt

# Ultralytics/YOLO runs
runs/

# macOS
.DS_Store

# Variáveis de ambiente (segredos)
.env.local
frontend/.env.local

# Node / Next.js
frontend/node_modules/
frontend/.next/

.vercel

# Backups e dados de referência (mantidos no disco, não versionados)
backups/
consultorias_fauna_siab.csv

# Claude Code — estado local da máquina
.claude/settings.local.json
.claude/scheduled_tasks.lock

# CDK synth snapshots avulsos (não o cdk.out padrão, já coberto em infra/.gitignore)
infra/cdk.out.diff/
infra/cdk.out2/
infra/cdk.out3/
