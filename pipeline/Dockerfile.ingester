# ── Ingester (extração de frames, sem PyTorch) ───────────────────────────────
# Build context: catalogador_animais/pipeline/
# CDK: DockerImageCode.from_image_asset("../pipeline", file="Dockerfile.ingester")
#
# Imagem leve (~200 MB vs ~1.2 GB do ML) — cold start rápido.

FROM public.ecr.aws/lambda/python:3.11

# cv2 precisa de libGL mesmo no modo headless
RUN yum install -y mesa-libGL && yum clean all

# Dependências mínimas: sem torch, sem ultralytics
RUN pip install --no-cache-dir \
    opencv-python-headless==4.10.0.84 \
    numpy==2.2.6 \
    boto3==1.43.36

# Código do pipeline (contexto já é pipeline/, então "." é o pacote inteiro)
COPY . ${LAMBDA_TASK_ROOT}/pipeline/

CMD ["pipeline.ingester.lambda_handler"]
